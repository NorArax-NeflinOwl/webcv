# Copy this file to .env and fill in real values.
# .env is listed in .gitignore and must never be committed.

# PostgreSQL
POSTGRES_DB=cvdb
POSTGRES_USER=cvuser
POSTGRES_PASSWORD=cvpass

# Spring Boot (used when running the app outside Docker)
DATABASE_URL=jdbc:postgresql://localhost:5432/cvdb
DATABASE_USERNAME=cvuser
DATABASE_PASSWORD=cvpass
