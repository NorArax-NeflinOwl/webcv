# Copy this file to .env and fill in real values.
# .env is listed in .gitignore and must never be committed.

# PostgreSQL. POSTGRES_PASSWORD is required: docker compose refuses to start without it.
POSTGRES_DB=cvdb
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
# Host port of the database container (optional, 127.0.0.1:5442 by default: loopback only)
# POSTGRES_HOST_PORT=127.0.0.1:5442

# Spring Boot (used when running the app outside Docker)
DATABASE_URL=jdbc:postgresql://localhost:5442/cvdb
DATABASE_USERNAME=your_db_user
DATABASE_PASSWORD=your_db_password
