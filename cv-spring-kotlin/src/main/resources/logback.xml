<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS, Europe/Warsaw} [%level] %logger{30} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.cvspringkotlin.service.PandaGamePlayerScoreService" level="DEBUG"/>
    <logger name="com.pokerkotlin.core.engine.GameEngine" level="DEBUG"/>
    <logger name="com.pokerkotlin.core.evaluation.HandEvaluator" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>
