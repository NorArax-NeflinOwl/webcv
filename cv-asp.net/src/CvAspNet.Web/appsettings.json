{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "CvAspNet.Poker.Engine.GameEngine": "Debug",
      "CvAspNet.Web.Services.PandaGamePlayerScoreService": "Debug"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss.fff "
      }
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:8281",
  "ConnectionStrings": {
    "CvDatabase": "Host=localhost;Port=5443;Database=cvdb;Username=cvuser"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "RateLimits": {
    "PokerTablesPerMinute": 10,
    "PokerJoinsPerMinute": 20,
    "PandaScoresPerMinute": 10
  },
  "Poker": {
    "MaxTables": 200,
    "IdleTableMinutes": 30,
    "DisconnectGraceSeconds": 120,
    "TurnTimeoutSeconds": 60,
    "SweepIntervalSeconds": 5,
    "MaxConnectionsPerSession": 3,
    "MaxConnections": 600
  }
}
