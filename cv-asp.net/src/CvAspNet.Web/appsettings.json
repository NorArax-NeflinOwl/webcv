{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "CvAspNet.Poker.Engine.GameEngine": "Debug",
      "CvAspNet.Web.Services.PandaGamePlayerScoreService": "Debug"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss.fff "
      }
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:8281",
  "ConnectionStrings": {
    "CvDatabase": "Host=localhost;Port=5443;Database=cvdb;Username=cvuser"
  },
  "Database": {
    "MigrateOnStartup": true
  }
}
