# Copy this file to .env and fill in real values ("run webcv.ps1" does it on the first run, with a random password).
# .env is listed in .gitignore and must never be committed.

# PostgreSQL
POSTGRES_DB=cvdb
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
# Host port of the database container (optional, 5443 by default)
# POSTGRES_HOST_PORT=5443

# ASP.NET Core (environment variables when running the app outside Docker, against "docker compose up db -d")
ConnectionStrings__CvDatabase=Host=localhost;Port=5443;Database=cvdb;Username=your_db_user
Database__Password=your_db_password
