# Copy this file to .env and fill in real values ("run webcv.ps1" does it on the first run, with a random password).
# .env is listed in .gitignore and must never be committed.

# PostgreSQL. POSTGRES_PASSWORD is required: docker compose refuses to start without it.
POSTGRES_DB=cvdb
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
# Host port of the database container (optional, 127.0.0.1:5443 by default: loopback only)
# POSTGRES_HOST_PORT=127.0.0.1:5443

# Host port of the application (optional, 8281 by default). It accepts address:port: the home server behind
# the gateway publishes the application on its LAN address, for the gateway Pi.
# APP_HOST_PORT=192.168.1.5:8281

# The reverse proxy (the gateway Pi) whose X-Forwarded-For / X-Forwarded-Proto the application believes, so that
# rate limits and logs see the visitor's address instead of the Pi's (optional; comma-separated addresses). Without
# it the headers are ignored, which is right when nothing sits in front of the application.
# FORWARDED_KNOWN_PROXIES=192.168.1.7

# ASP.NET Core (environment variables when running the app outside Docker, against "docker compose up db -d")
ConnectionStrings__CvDatabase=Host=localhost;Port=5443;Database=cvdb;Username=your_db_user
Database__Password=your_db_password
